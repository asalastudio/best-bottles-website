# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules
**/node_modules/
/.pnp
.pnp.js

# Next.js build output & caches
/.next
**/.next/
/out
/build

# Vercel deployment metadata & caches
/.vercel

# Compiled Sanity Studio
/dist

# Temporary Sanity runtime, generated by the CLI on every dev server start
/.sanity

# Logs
/logs
*.log

# Local automation / browser scratch
/.codex/
/.claude/worktrees/
/.cursor/settings.json
/.firecrawl/
/.playwright-cli/
/.playwright-mcp/

# Local scratch and generated test outputs
/tmp/
/topaz-test/
/ziOGLQ3X
/madison-image-pipeline-diagnostic/
/madison-image-pipeline-diagnostic.zip

# Repo-root image exports are local scratch; production assets live in public/
# or Sanity/CDN.
/*.png
/*.jpg
/*.jpeg
/*.webp

# Local packaged skills belong in AIOS, not this app repo.
/_skills/

# Best Bottles / Madison pipeline generated or local-only data
/pipeline/*
!/pipeline/aios-shopify-pdp-images/
/pipeline/aios-shopify-pdp-images/*
!/pipeline/aios-shopify-pdp-images/prompt-template.mjs
!/pipeline/best-bottles-reference-images-clean/
!/pipeline/best-bottles-reference-images-clean/**/
!/pipeline/best-bottles-reference-images-clean/**/*.md
!/pipeline/best-bottles-reference-images-clean/**/*.csv
!/pipeline/best-bottles-reference-images-clean/**/*.json
!/pipeline/best-bottles-reference-images-clean/**/.gitkeep
/pipeline/best-bottles-reference-images-clean/**/*.psd
/pipeline/best-bottles-reference-images-clean/**/*.psb
/pipeline/best-bottles-reference-images-clean/**/*.png
/pipeline/best-bottles-reference-images-clean/**/*.jpg
/pipeline/best-bottles-reference-images-clean/**/*.jpeg
/pipeline/best-bottles-reference-images-clean/**/*.webp
/pipeline/best-bottles-reference-images-clean/**/*.gif
/pipeline/**/.env
/pipeline/**/output/
/pipeline/**/processing/
/pipeline/**/reference-images/
/pipeline/**/source-psds/
/pipeline/**/renders/
/scripts/madison-pipeline/
/scripts/madison-pipeline/output/

# Generated audit/eval/report snapshots
/data/grace-evals/results/
/data/audits/20*/convex_snapshot*.json
/data/audits/2026-05-20-image-audit/
/data/audits/product-truth/
/data/audits/convex-grace-sku-truth-2026-06-19/
/data/audits/launch-health-2026-06-22/
/data/audits/shopify_sku_mapping_launch_audit_2026-06-22.json
/Best-Bottles-Master-Product-Sheet-2026-06-21/
/data/source-of-truth/
/docs/data_alignment/*.json
/docs/data_alignment/*.xlsx
/mobile-audit-screenshots/

# Coverage directory used by testing tools
/coverage

# Misc
.DS_Store
**/.DS_Store
__pycache__/
*.pyc
*.pem
~$*
.~lock.*

# Typescript
*.tsbuildinfo

# Dotenv and similar local-only files
*.local

# Env backups — may contain live secrets (write tokens, API keys); never commit
.env*.bak*
.env.local.bak*
*.bak-clerk-toggle

# MCP configs — contain live API keys and admin tokens; never commit
.mcp.json
.cursor/mcp.json

# Local editor workspace files
*.code-workspace

# Local creative assets (84MB+, not for git)
creative/

# Paper Doll 3D lane — track the scripts and the written record, never the
# binaries. Blend files and renders are build artifacts: a re-run of
# scripts/paper-doll-3d/ regenerates them deterministically.
!/pipeline/paper-doll-3d/
!/pipeline/paper-doll-3d/**/
!/pipeline/paper-doll-3d/**/*.md
!/pipeline/paper-doll-3d/**/*.json
!/pipeline/paper-doll-3d/**/.gitkeep
/pipeline/paper-doll-3d/**/*.blend
/pipeline/paper-doll-3d/**/*.blend[0-9]
/pipeline/paper-doll-3d/**/*.glb
/pipeline/paper-doll-3d/**/*.png
/pipeline/paper-doll-3d/**/*.jpg

# --- bottle-bodies 3D lane: regenerable outputs (see pipeline/paper-doll-3d/HANDOFF-2026-08-30.md)
# Silhouette cache: ~529 MB, rebuilt by extract_psd_silhouette.py in ~19 min.
pipeline/paper-doll-3d/silhouettes/
# Working build output; the frozen copy in releases/ is the keeper.
pipeline/paper-doll-3d/glb/
pipeline/paper-doll-3d/logs-batch*.txt

# --- bottle-bodies 3D lane: scratch build dirs from the 2026-08-30 threading
# work. Every one is regenerable by bottle_bodies.py; the keeper set lives in
# public/models/. glb-*/ contents are already covered by the *.glb rule above —
# these lines catch the body_report.csv each run drops beside them.
pipeline/paper-doll-3d/glb-*/
# Product photos pulled from bestbottles.com by shape_truth.py — re-fetchable,
# and not ours to vendor into the repo.
pipeline/paper-doll-3d/cache/
# Output of a tool that does not yet reproduce hand measurements; committing it
# would dress unreliable numbers up as a record.
pipeline/paper-doll-3d/shape-truth.csv
