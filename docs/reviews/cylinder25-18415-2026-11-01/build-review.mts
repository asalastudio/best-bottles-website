base=base.slice(0,begin)+`document.getElementById('contact').innerHTML=data.order.map((g,gi)=>{const items=data.entries.filter(e=>e.group===g);const selected=items.every(e=>e.fitment==='Screw Cap')?items:[...new Set(items.map(e=>e.fitment))].map(f=>items.find(e=>e.fitment===f));return '<section class="group"><h2>'+escape(items[0].title)+' · '+items.length+' configurations</h2><div class="tiles">'+selected.map((e,i)=>'<article class="tile">'+svg(e,e.allowed.includes('sidecar')?'sidecar':e.allowed[0],'contact-'+gi+'-'+i)+'<p><strong>'+escape(e.fitment+' · '+e.finish)+'</strong>'+escape(e.sku)+'</p></article>').join('')+'</div></section>';}).join('');`+base.slice(end);
