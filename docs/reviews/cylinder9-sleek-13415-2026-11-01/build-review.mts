function svg(entry,mode,id){const l=entry.views[mode],f=l.frame,c=l.canvas;return '<svg viewBox="0 0 '+c.width+' '+c.height+'" aria-label="'+escape(entry.title+' '+entry.fitment+' '+entry.finish)+'"><g transform="translate('+(f.x/100*c.width)+' '+(f.y/100*c.height)+') scale('+f.scale+')">'+l.parts.map((p,i)=>{const x=((p.box?.leftPct??0)+p.dxPct)/100*c.width,y=((p.box?.topPct??0)+p.dyPct)/100*c.height,w=(p.box?.widthPct??100)/100*c.width,h=(p.box?.heightPct??100)/100*c.height,clip=id+'-'+i;return(p.clipBottomPct===undefined?'':'<defs><clipPath id="'+clip+'" clipPathUnits="userSpaceOnUse"><rect x="'+x+'" y="'+y+'" width="'+w+'" height="'+h*(1-p.clipBottomPct/100)+'"/></clipPath></defs>')+'<image href="'+escape(p.url)+'" x="'+x+'" y="'+y+'" width="'+w+'" height="'+h+'" opacity="'+(p.opacity??1)+'" style="mix-blend-mode:'+(p.blendMode??'normal')+'"'+(p.clipBottomPct===undefined?'':' clip-path="url(#'+clip+')"')+'/>';}).join('')+'</g></svg>';}
function render(){const items=data.entries.filter(e=>e.group===group),entry=items.find(e=>e.sku===sku)||items[0];sku=entry.sku;document.getElementById('groups').innerHTML=data.order.map(g=>{const e=data.entries.find(e=>e.group===g);return '<button data-group="'+g+'" aria-pressed="'+(g===group)+'">'+escape(e.title)+'</button>';}).join('');document.getElementById('config').innerHTML=items.map(e=>'<option value="'+e.sku+'"'+(e.sku===sku?' selected':'')+'>'+escape(e.fitment+' · '+e.finish)+'</option>').join('');document.getElementById('views').innerHTML=[['sidecar','Cap off'],['capon','Cap on'],['exploded','Exploded']].map(([id,label])=>'<button data-view="'+id+'" aria-pressed="'+(id===view)+'">'+label+'</button>').join('');document.getElementById('stage').innerHTML=svg(entry,view,'main');document.getElementById('title').textContent=entry.title+' · '+entry.finish;document.getElementById('sku').textContent=entry.sku;document.getElementById('product').href=entry.url;}
