# Keep deploy uploads small. Without this, `vercel deploy` ships the entire
# working tree — 26+ GB and 27,928 files, which exceeds Vercel's 15,000-file
# limit and forces --archive=tgz. None of the paths below are imported by the
# Next.js app or needed by the build; they are local working assets.

# Madison paper-doll source library (~36 GB of PSDs/renders)
pipeline/

# Local research, audit, and scrape artifacts — except the asset-ledger JSON, which the
# Team asset-ledger page and its API route import at build/run time (Vercel applies this file
# to Git builds too; excluding it broke every production build with "Module not found").
data/*
!data/asset-ledger/
!data/reconciliation/
# The product page imports these at build time: the item descriptions and the dimension-drawing
# geometry. gitignore semantics: a directory excluded by data/* must be re-included before anything
# inside it can be, so data/register/ comes back only for its drawings/ folder.
!data/descriptions/
!data/register/
data/register/*
!data/register/drawings/
docs/
reference_images/
Best-Bottles-Orphan-urls/

# Convex snapshot exports and local dumps
*.zip

# Test/report outputs
coverage/
dist/

# Preserved generation sources and local review artifacts are not storefront assets.
output/

# Local model audits, backups and restored review pages are not release assets.
outputs/
public/reviews/*-2026-10-31/

# November 1 family review assets and the local-only configuration override.
public/reviews/*-2026-11-01/
public/local-kits/cylinder5-all71-2026-11-01/

# Source review inventories remain local; approved recipes use immutable hosted URLs.
public/local-kits/cylinder9-masters-2026-11-01/

# The 25 ml pilot remains local until its exact sources and frame holds are reviewed.
public/local-kits/cylinder25-18415-2026-11-01/

# Local shoulder correction mirrors the hosted approved recipe.
public/local-kits/tulip-amber-seating-2026-11-01/

# Rectangle applicator candidates require visual approval before release.
public/local-kits/rectangle9-applicator-2026-11-01/

# Source copies of approved vial bodies and the local Tulip optics mirror.
public/local-kits/vial2-matched-2026-11-01/
public/local-kits/tulip6-glass-depth-2026-11-01/

# Local mirror of the Sleek 8 ml glass-depth correction.
public/local-kits/sleek8-glass-depth-2026-11-01/

# Local review bodies and delivery layers; production uses approved hosted media.
public/local-kits/vial3-swatches-builder-2026-11-02/
public/local-kits/jumbo28-archive-geometry-2026-11-02/
public/local-kits/cylinder-family-completion-2026-11-02/

# ── 2026-11-05 cleanup audit (docs/audits/2026-11-05-cleanup-audit.md) ─────────
# Each folder below has no runtime reference: no static import, no URL built from a
# SKU or slug, no Convex/Shopify/Sanity image URL (3 Nov 2026 image evidence, 90k
# rows), no publish-script output that the storefront reads. Tests and scripts that
# read them run from the git clone, not from the deployment.

# Review inputs for scripts/assemble-cylinder-hover.cjs and the non-bottle media review.
public/preview/

# Review artefacts with no src/convex/data/asset-ledger reference. The folders the
# Team asset-ledger page links to (legacy-rebuild, legacy-hold-evidence, cylinder-final38,
# four-family-plates, …) and public/reviews/cylinder28-sunburst-2026-11-04 (PdpRedesignPage)
# stay deployed.
public/reviews/builder-bodies-2026-09-14/
public/reviews/kit-completion-2026-09-19/
public/reviews/cylinder-remaining-closure-audit-2026-09-13/
public/reviews/cylinder9-glass-material-2026-11-02/
public/reviews/builder-review-2026-09-19/
public/reviews/plate-completion-2026-09-18/
public/reviews/jumbo-bottle-source-check-2026-11-02/
public/reviews/cylinder50-native-2026-11-04/
public/reviews/cylinder-family-completion-2026-11-02/
public/reviews/cylinder25-material-cleanup-2026-11-02/
public/reviews/jumbo50-body-reference-2026-11-02/
public/reviews/jumbo28-archive-geometry-2026-11-02/
public/reviews/jumbo-roller-psd-match-2026-11-02/
public/reviews/jumbo-roller-material-2026-11-02/
public/reviews/pillar-masters-2026-11-04/
public/reviews/egd-masters-2026-11-04/
public/reviews/cylinder-small-2026-09-22/

# Superseded Empire hero sets. EmpireFitmentHero reads `/assets/hero/${NEXT_PUBLIC_HERO_SET ?? "v8"}/`;
# the variable is not set on Vercel (checked 5 Nov 2026) and the v8 manifest only names v8 files.
public/assets/hero/v4/
public/assets/hero/v5/
public/assets/hero/v6/
public/assets/hero/v7/
public/assets/hero/frames/

# Card artwork candidates; the homepage reads the copies in public/assets/homepage.
public/assets/cards/

# Reference photographs mentioned only in comments (src/lib/materials/glassPresets.ts).
public/references/
