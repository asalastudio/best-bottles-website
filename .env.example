# ─────────────────────────────────────────────────────────────────────────────
# Best Bottles — Environment Variables
# Copy this file to .env.local and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Convex (required) ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.bestbottles.com
NEXT_PUBLIC_CONVEX_URL=              # Convex deployment URL (e.g. https://your-project.convex.cloud)
NEXT_PUBLIC_CONVEX_SITE_URL=         # Convex HTTP routes base URL (e.g. https://your-project.convex.site)

# ── Sanity CMS (required for editorial content) ──────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=       # Sanity project ID from sanity.io/manage
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-03-01

# Sanity Studio overrides (optional — falls back to NEXT_PUBLIC_ vars above)
# SANITY_STUDIO_PROJECT_ID=
# SANITY_STUDIO_DATASET=

# ── Shopify (required for checkout & variant sync) ────────────────────────────
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=    # e.g. your-store.myshopify.com
SHOPIFY_ADMIN_TOKEN=                 # Shopify Admin API access token (keep secret)
# Headless Storefront API token (custom app → API credentials → Storefront API).
# Required for the Plus checkout handoff: cartCreate → hosted checkoutUrl.
# Server-only. Checkout falls back to /cart/id:qty permalinks if this is unset.
SHOPIFY_STOREFRONT_TOKEN=
# Verifies X-Shopify-Hmac-Sha256. Use the custom app's "API secret key" (same screen as API key) — NOT the Admin access token (shpat_). See Shopify HTTPS webhook verification docs.
SHOPIFY_WEBHOOK_SECRET=

# ── AI Services (required for Grace AI assistant) ─────────────────────────────
OPENAI_API_KEY=                      # OpenAI API key (voice, realtime, transcription)
TYPESAFE_API_KEY=                    # TypeSafe Jev (Grace intent filters); server-side only
OPENAI_KNOWLEDGE_ROUTINE_MODEL=gpt-5.6-luna
OPENAI_KNOWLEDGE_COMPLEX_MODEL=gpt-5.6-terra
OPENAI_KNOWLEDGE_EXECUTIVE_MODEL=gpt-5.6-sol
OPENAI_PUBLIC_KNOWLEDGE_VECTOR_STORE_ID=
OPENAI_INTERNAL_KNOWLEDGE_VECTOR_STORE_ID=
OPENAI_EXECUTIVE_KNOWLEDGE_VECTOR_STORE_ID=
BEST_BOTTLES_CONVEX_WRITE_TOKEN=     # Same secret in Next.js and Convex server environments
ANTHROPIC_API_KEY=                   # Anthropic API key (Claude model for Grace) — set in Convex dashboard env vars

# ── Grace Realtime ────────────────────────────────────────────────────────────
NEXT_PUBLIC_GRACE_PROVIDER=openai    # "openai" (default) or temporary rollback value "elevenlabs"

# ── ElevenLabs rollback only (remove after OpenAI stability window) ───────────
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_VOICE_ID=
ELEVENLABS_WEBHOOK_SECRET=

# ── Observability (Sentry) ────────────────────────────────────────────────────
# The SDK is a complete no-op until the DSN is set. See docs/observability/SENTRY_RUNBOOK.md
NEXT_PUBLIC_SENTRY_DSN=              # "best-bottles-web" project DSN (browser + server + edge)
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE= # optional 0..1; defaults to 0.05 in production, 0 elsewhere
SENTRY_ORG=                          # org slug — source-map upload at build time
SENTRY_PROJECT=                      # web project slug — source-map upload at build time
SENTRY_AUTH_TOKEN=                   # CI/Vercel only; enables source-map upload. Never commit.
SENTRY_WEBHOOK_CLIENT_SECRET=        # Internal Integration "Client Secret"; verifies POST /api/sentry/webhook
# Convex dashboard env (dev AND prod deployments), read by convex/observability.ts:
#   SENTRY_API_TOKEN      org auth token with org:read + project:read + event:read (15-min issue sync)
#   SENTRY_ORG_SLUG       org slug
#   SENTRY_PROJECT_SLUGS  optional comma list to mirror only these projects
#   SENTRY_API_BASE_URL   optional; https://sentry.io (US, default) or https://de.sentry.io (EU)
NEXT_PUBLIC_MADISON_STUDIO_URL=      # Team Hub link to Madison Studio (defaults to https://app.madisonstudio.io)

# ── Clerk / Portal Auth (optional; leave false until keys are verified) ─────
NEXT_PUBLIC_CLERK_ENABLED=false
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/portal
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/portal
TEAM_HUB_ALLOWED_EMAILS=jordan@asala.ai,abbas@nematinternational.com
EXECUTIVE_HUB_ALLOWED_EMAILS=jordan@asala.ai,abbas@nematinternational.com

# Paper-doll plate store (importer only -- the site never needs these)
BLOB_READ_WRITE_TOKEN=
PLATE_STORE=blob
# Private masters archive (Cloudflare R2, S3 API; no custom domain needed)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_MASTERS_BUCKET=

# ─── Analytics (PostHog) ─────────────────────────────────────────────────────
# Project API key. Absent means analytics does not start — which is the right
# default for a preview that should not write into the production project.
NEXT_PUBLIC_POSTHOG_KEY=
# Defaults to https://us.i.posthog.com. Set only for EU or self-hosted.
NEXT_PUBLIC_POSTHOG_HOST=

# ─── PostHog inside Convex (set on the Convex DEPLOYMENT, not here) ──────────
# npx convex env set POSTHOG_PROJECT_TOKEN phc_...
# Same phc_ key the browser uses. Server events are captured through
# convex/posthog.ts; a missing token degrades to a logged warning and never
# fails the mutation it was observing.
#   POSTHOG_PROJECT_TOKEN   required by the component
#   POSTHOG_HOST            only for EU or self-hosted
#   POSTHOG_PERSONAL_API_KEY  only for local feature-flag evaluation
